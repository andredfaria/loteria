*.joblib
*.keras
*.h5
*.pkl

# ── SQLite ─────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ── Ambiente local ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

